<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- WcsDbContext 모델 참조 -->
    <ProjectReference Include="..\Wcs.Data\Wcs.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- SQLite provider — 마이그레이션 생성에 필요 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.5" />
    <!-- Design 도구 — dotnet ef migrations add 시 필요 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 마이그레이션 어셈블리 — EF 런타임이 이 어셈블리에서 마이그레이션 스캔 -->
    <RootNamespace>Wcs.Migrations.Sqlite</RootNamespace>
  </PropertyGroup>
</Project>
